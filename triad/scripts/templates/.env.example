# Triad Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Slack Bot Token (get from https://api.slack.com/apps)
# Required scopes: chat:write, channels:read, channels:manage, users:read
SLACK_BOT_TOKEN=xoxb-your-token-here

# Project Slack Channel (without the # prefix)
# This is set automatically by slack_new_project.sh
TRIAD_SLACK_CHANNEL=triad-yourproject
