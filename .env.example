# Copy this file to .env and replace placeholders with your real secrets.
# Database URL used by SQLAlchemy (e.g., sqlite:///./cryptotrader.db)
DATABASE_URL=sqlite:///./cryptotrader.db
KRAKEN_API_KEY=your_kraken_api_key
KRAKEN_API_SECRET=your_kraken_api_secret
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key_optional
SLACK_BOT_TOKEN=your_slack_bot_token
TRIAD_SLACK_CHANNEL=triad-cryptotrader
